# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/revista_ivd?schema=public"

# Secreto para firmar las cookies de sesión (JWT). OBLIGATORIO en producción
# — si falta, la app no arranca a propósito (ver lib/session.ts).
# Generalo con: openssl rand -base64 48
SESSION_SECRET="cambiar-por-un-secreto-largo-y-random"

# URL pública de la app, usada para armar los links de los mails
# (acceso temporal de profesores). En producción: https://revista.institutoverbodivino.edu.ar
APP_URL="http://localhost:3000"

# SMTP para el envío real de mails (verificación, links de acceso, avisos de
# revisión). Si se deja vacío, los mails se loguean por consola en vez de
# enviarse — útil para desarrollo, pero OBLIGATORIO completar en producción.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Revista IVD <no-reply@institutoverbodivino.edu.ar>"

# Usuario admin creado por el seed (prisma/seed.ts). Cambiar antes de
# producción — si no se completan, se usan los valores por defecto del
# script (inseguros, solo para desarrollo).
ADMIN_EMAIL="admin@institutoverbodivino.edu.ar"
ADMIN_PASSWORD="cambiar-esta-password"
